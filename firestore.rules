rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.uid in ['iMey77WyBccVB1wVFlqdWlrviLx2']; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function isNotLimited() {
      return signedIn() && (!exists(userPath(request.auth.uid)) || get(userPath(request.auth.uid)).data.banned != true);
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName','displayNameLower','avatar','bio','status','theme','musicUrl','musicTitle','musicDuration','musicMime','lastSeen','updatedAt'
        ]);
      allow update: if isAdmin()
        && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banned','warns','lastWarnReason','lastWarnAt']);
      allow delete: if false;
    }

    match /messages/{messageId} {
      allow read: if signedIn();
      allow create: if isNotLimited() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isNotLimited() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /reports/{reportId} {
      allow create: if isNotLimited()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly([
          'reporterUid','reporterName','reportedUid','reportedName','messageId','messageText','reason','note','status','createdAt','chatType'
        ]);
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    match /adminInbox/{uid}/messages/{msgId} {
      allow read, update: if isOwner(uid) || isAdmin();
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    match /chatMeta/{docId} {
      allow read: if signedIn();
      allow write: if isNotLimited();
    }

    match /polls/{pollId} {
      allow read: if signedIn();
      allow create: if isNotLimited() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isNotLimited() && (resource.data.createdBy == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
      match /votes/{uid} {
        allow read: if signedIn();
        allow create, update: if isNotLimited() && isOwner(uid);
        allow delete: if isOwner(uid) || isAdmin();
      }
    }

    match /dmConvs/{convId} {
      allow read, create, update: if isNotLimited() && request.auth.uid in request.resource.data.members;
      allow delete: if false;
      match /messages/{messageId} {
        allow read, create, update, delete: if isNotLimited();
      }
    }

    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if isNotLimited();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
